
    /**
     * {@code copy}: element copy without conversion. Loop {@code ${SIGNATURE}}.
     *
     * @param a  input memory
     * @param pa byte offset of the input's first element
     * @param sa input byte stride
     * @param o  output memory
     * @param po byte offset of the output's first element
     * @param so output byte stride
     * @param n  number of elements
     */
    public static void copy(MemorySegment a, long pa, long sa, MemorySegment o, long po, long so, long n) {
        if (so == ${ISIZE} && sa == ${ISIZE}) {
            MemorySegment.copy(a, pa, o, po, ${BYTES});
        } else {
            for (long i = 0; i < n; i++, pa += sa, po += so) {
                o.set(${LAYOUT}, po, a.get(${LAYOUT}, pa));
            }
        }
    }
